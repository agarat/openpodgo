#!/usr/bin/env bash
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
REPO_DIR="$(CDPATH="" cd -- "$(dirname -- "$SCRIPT_PATH")/.." >/dev/null 2>&1 && pwd)"

# Parse optional --scale (scales whole UI) or --font-scale (scales text only)
ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --scale)
      export QT_SCALE_FACTOR="$2"
      shift 2
      ;;
    --scale=*)
      export QT_SCALE_FACTOR="${1#*=}"
      shift
      ;;
    --font-scale)
      export PODGO_FONT_SCALE="$2"
      shift 2
      ;;
    --font-scale=*)
      export PODGO_FONT_SCALE="${1#*=}"
      shift
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

exec "${REPO_DIR}/.venv/bin/openpodgo" "${ARGS[@]}"
