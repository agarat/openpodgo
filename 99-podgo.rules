# Acceso USB sin sudo a dispositivos Line 6 (POD Go / Helix / HX).
# Instalar con:
#   sudo cp 99-podgo.rules /etc/udev/rules.d/99-podgo.rules
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# Luego desconectar y reconectar el POD Go.
SUBSYSTEM=="usb", ATTR{idVendor}=="0e41", MODE="0666", TAG+="uaccess"
